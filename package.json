{
  "name": "stitchtrack",
  "version": "0.1.0",
  "private": true,
  "description": "StitchTrack tailoring order management application",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "bash scripts/prisma.sh validate --schema prisma/schema.prisma",
    "prisma:generate": "bash scripts/prisma.sh generate --schema prisma/schema.prisma",
    "db:migrate": "bash scripts/prisma.sh migrate dev --schema prisma/schema.prisma",
    "db:migrate:status": "bash scripts/prisma.sh migrate status --schema prisma/schema.prisma",
    "db:deploy": "bash scripts/prisma.sh migrate deploy --schema prisma/schema.prisma",
    "db:verify": "node --env-file=.env.local --import tsx scripts/verify-database.ts",
    "prisma:install": "npm install --prefix tools/prisma-cli",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@node-rs/argon2": "2.2.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
